NODE_ENV=development
PORT=4000

# PostgreSQL — use a managed instance in production (Supabase, Neon, or Render Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flashkings?schema=public"

# JWT — generate real secrets with `openssl rand -hex 32`, never reuse across environments
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookies — COOKIE_DOMAIN must be the apex domain (e.g. "flashkings.pe") in production so the
# cookie is valid for both flashkings.pe and any subdomain the frontend is served from
COOKIE_DOMAIN="localhost"
# Comma-separated allowlist, no wildcard — e.g. "https://flashkings.pe,https://www.flashkings.pe"
CORS_ORIGIN="http://localhost:3000"

# Frontend URL — used to build links inside transactional emails
FRONTEND_URL="http://localhost:3000"

# Redis / BullMQ (stock hold engine + rate limiting) — use a managed instance in production (Redis Cloud, Upstash)
REDIS_URL="redis://localhost:6379"
STOCK_HOLD_MINUTES=15

# Payments — set PAYMENT_GATEWAY=culqi and fill the keys below once you have a Culqi sandbox account
PAYMENT_GATEWAY="fake"
CULQI_PUBLIC_KEY=""
CULQI_SECRET_KEY=""
# No CULQI_WEBHOOK_SECRET: Culqi doesn't publish a webhook signature scheme to verify against.
# The webhook handler re-fetches each charge's real status from Culqi's own API with
# CULQI_SECRET_KEY instead of trusting the webhook body — see CulqiPaymentGateway.

# Email — set EMAIL_PROVIDER=resend and fill RESEND_API_KEY once you have a Resend account.
# EMAIL_PROVIDER=console (default) logs the rendered email instead of sending — no credentials needed for local dev.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Flashkings <pedidos@flashkings.pe>"

# WhatsApp — Peru phone number (no country code, no symbols) shown to the admin for wa.me links.
# No WhatsApp Business API integration configured; this is only used to build shareable links.
WHATSAPP_BUSINESS_PHONE=""
