// Flashkings E-Commerce - Prisma Schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  name           String
  phone          String?
  defaultAddress String?  @map("default_address")
  role           Role     @default(CLIENT)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Token de un solo uso, solo se persiste su hash SHA-256 (nunca el token en claro) — mismo
  // criterio que el certificado digital SUNAT: nunca guardar el secreto en sí.
  passwordResetTokenHash      String?   @map("password_reset_token_hash")
  passwordResetTokenExpiresAt DateTime? @map("password_reset_token_expires_at")

  // No bloqueante a propósito (ver VerifyEmailUseCase/RegisterUseCase): un cliente sin verificar
  // igual puede comprar y usar la cuenta, solo se le muestra un aviso.
  emailVerifiedAt                 DateTime? @map("email_verified_at")
  emailVerificationTokenHash      String?   @map("email_verification_token_hash")
  emailVerificationTokenExpiresAt DateTime? @map("email_verification_token_expires_at")

  orders Order[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  brand       String
  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id])
  isFeatured  Boolean  @default(false) @map("is_featured")
  // Baja lógica. Un producto que ya se vendió NO se puede borrar: sus OrderItem (y, tras ellos,
  // los RefundItem y el comprobante SUNAT ya emitido) lo referencian, y ese comprobante tiene que
  // seguir siendo explicable — ya vive en los servidores de SUNAT. Desactivar lo saca del catálogo
  // público, la búsqueda y el sitemap sin tocar una sola venta histórica.
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  variants ProductVariant[]
  images   ProductImage[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@map("products")
}

// Variants model concrete purchasable SKUs (switch type, color, size, etc.)
// attributes is a free-form Json bag so new variant dimensions don't require migrations.
model ProductVariant {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String   @unique
  name          String
  price         Decimal  @db.Decimal(10, 2)
  costPrice     Decimal  @map("cost_price") @db.Decimal(10, 2) // ADMIN-only field, never serialized to public API
  stock         Int      @default(0)
  reservedStock Int      @default(0) @map("reserved_stock") // units held by PENDING_PAYMENT orders; available = stock - reservedStock
  attributes    Json     @default("{}")
  // Misma baja lógica que Product, un nivel más abajo: sirve para descontinuar un color o un tipo
  // de switch sin bajar el producto entero. Una variante inactiva no se puede comprar ni cuenta
  // para el `inStock` público del producto.
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[]
  images     ProductImage[]

  @@index([productId])
  @@map("product_variants")
}

// productVariantId is nullable: null means a "shared" image shown as the fallback gallery for
// any variant that has none of its own, and it's the only kind ProductCard (catalog grid, which
// never knows about a selected variant) can show. isPrimary's "only one" invariant is scoped to
// (productId, productVariantId) as a pair, so each variant can also have its own designated
// primary among just its own images, independent of the shared bucket's primary.
model ProductImage {
  id               String          @id @default(uuid())
  productId        String          @map("product_id")
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId String?         @map("product_variant_id")
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  url              String
  altText          String?         @map("alt_text")
  isPrimary        Boolean         @default(false) @map("is_primary")

  @@index([productId])
  @@index([productVariantId])
  @@map("product_images")
}

// REFUNDED is the terminal state of an order that WAS paid and got its money back in full.
// It's deliberately separate from CANCELLED: CANCELLED means the order died before any money
// moved (hold expired, charge declined, manual payment rejected), so there is nothing to return
// and physical stock was never decremented. REFUNDED means the opposite on both counts — see
// RefundOrderUseCase. A PARTIAL refund never reaches this state: the order keeps whatever status
// it had (a delivered order stays DELIVERED) and only carries a Refund row.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PREPARATION
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum CancelReason {
  EXPIRED_HOLD
  PAYMENT_DECLINED
  ADMIN_CANCELLED
}

// Las dos zonas de la tarifa plana. "Lima Metropolitana" incluye la Provincia Constitucional del
// Callao, como es práctica estándar del e-commerce peruano — y NO incluye las provincias del
// departamento de Lima (Huaura, Cañete, Barranca…), que se despachan como provincia.
enum ShippingZone {
  LIMA_METROPOLITANA
  PROVINCIA
}

model Order {
  id              String        @id @default(uuid())
  userId          String?       @map("user_id")
  user            User?         @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PENDING_PAYMENT)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(10, 2)
  customerName    String        @map("customer_name")
  customerEmail   String        @map("customer_email")
  customerPhone   String        @map("customer_phone")
  shippingAddress String        @map("shipping_address")
  // Ubicación estructurada, necesaria para tarifar el envío. `shippingAddress` sigue siendo la
  // calle/referencia libre. Nullable porque las órdenes anteriores al envío tarifado no la tienen
  // y no se puede inventar retroactivamente.
  shippingDepartment String?    @map("shipping_department")
  shippingProvince   String?    @map("shipping_province")
  shippingDistrict   String?    @map("shipping_district")
  // Zona congelada en la orden, no derivada al leer: si mañana cambia qué cuenta como Lima
  // Metropolitana, una orden de hace tres meses debe seguir explicando el flete que se le cobró.
  shippingZone    ShippingZone? @map("shipping_zone")
  // Flete cobrado, ya incluido en totalAmount. Congelado igual que OrderItem.price: un cambio de
  // tarifa posterior nunca altera lo que se le cobró a una orden ya creada.
  shippingCost    Decimal       @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  cancelReason    CancelReason? @map("cancel_reason")
  paidAt          DateTime?     @map("paid_at")
  cancelledAt     DateTime?     @map("cancelled_at")
  trackingNumber  String?       @map("tracking_number")
  courier         String?
  refundedAt      DateTime?     @map("refunded_at")
  items           OrderItem[]
  payment         Payment?
  // Was Invoice? (1-1) before credit notes existed. An order can now hold its comprobante plus
  // one or more notas de crédito that correct it, so the relation is 1-N; the domain's Order
  // still exposes a single `invoice` (the comprobante, never a note) plus `creditNotes` —
  // see PrismaOrderRepository.toDomain.
  invoices        Invoice[]
  refunds         Refund[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([userId])
  @@map("orders")
}

// price is the unit price frozen at purchase time — OrderItem must never re-read ProductVariant.price later.
model OrderItem {
  id               String         @id @default(uuid())
  orderId          String         @map("order_id")
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String         @map("product_variant_id")
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity         Int
  price            Decimal        @db.Decimal(10, 2)
  // How many units of this line have already been refunded across all partial refunds. Kept on
  // the line (not derived by summing Refund rows) so the "can I still refund this item?" check is
  // a single locked read of the same row it's about — same reasoning as reservedStock on
  // ProductVariant. Always <= quantity; enforced inside the refund transaction.
  refundedQuantity Int            @default(0) @map("refunded_quantity")

  refundItems RefundItem[]

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

enum RefundStatus {
  PENDING // registrada, el dinero todavía no volvió (reembolso manual sin ejecutar, o gateway async)
  COMPLETED
  FAILED
}

// Un reembolso: total (toda la orden) o parcial (algunos ítems/monto). Separado de Payment por la
// misma razón que Payment está separado de Order — una orden puede acumular varios reembolsos
// parciales contra un único cargo, así que la relación con Payment es 1-N, no 1-1.
model Refund {
  id               String       @id @default(uuid())
  orderId          String       @map("order_id")
  order            Order        @relation(fields: [orderId], references: [id])
  paymentId        String?      @map("payment_id")
  payment          Payment?     @relation(fields: [paymentId], references: [id])
  amount           Decimal      @db.Decimal(10, 2)
  // true = devolvió el total de la orden y la dejó en REFUNDED; false = parcial, la orden conserva su estado.
  isFull           Boolean      @default(false) @map("is_full")
  status           RefundStatus @default(PENDING)
  // Catálogo 09 de SUNAT (motivo de nota de crédito) — se guarda acá porque es el mismo motivo
  // que viaja al comprobante de corrección, no un texto aparte. Ver note-catalogs.ts.
  reasonCode       String       @map("reason_code")
  reasonText       String       @map("reason_text")
  // Si el dinero se devolvió por fuera (transferencia manual, Yape del admin) en vez de por la
  // API de la pasarela — el flujo espejo de SubmitManualPaymentUseCase en el lado del cobro.
  isManual         Boolean      @default(false) @map("is_manual")
  providerRefundId String?      @map("provider_refund_id")
  rawResponse      Json?        @map("raw_response")
  // Si se repuso el stock físico. Un producto que volvió al almacén sí; uno perdido/dañado en
  // tránsito no — es decisión del admin al momento de reembolsar, no una regla automática.
  restocked        Boolean      @default(false)
  // Si este reembolso incluye el flete. Práctica estándar: se devuelve cuando la falla es del
  // negocio (producto fallado, error de despacho, pedido que no se pudo cumplir) y no cuando el
  // cliente se arrepiente — el envío ya se prestó como servicio. No se deriva del motivo SUNAT
  // porque el catálogo 09 no distingue culpa: "06 Devolución total" cubre los dos casos.
  includesShipping Boolean      @default(false) @map("includes_shipping")
  createdById      String?      @map("created_by_id")
  createdAt        DateTime     @default(now()) @map("created_at")

  items      RefundItem[]
  creditNote Invoice?

  @@index([orderId])
  @@index([paymentId])
  @@map("refunds")
}

// Qué se devolvió, línea por línea. Vacío en un reembolso total por monto (sin desglose de ítems),
// poblado en uno parcial — es lo que alimenta las líneas de la nota de crédito.
model RefundItem {
  id          String    @id @default(uuid())
  refundId    String    @map("refund_id")
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItemId String    @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int

  @@index([refundId])
  @@index([orderItemId])
  @@map("refund_items")
}

// Separate from Order: the gateway's charge lifecycle (retries, refunds, raw payload)
// is distinct from our own order state machine.
model Payment {
  id               String   @id @default(uuid())
  orderId          String   @unique @map("order_id")
  order            Order    @relation(fields: [orderId], references: [id])
  provider         String   @default("culqi")
  providerChargeId String?  @map("provider_charge_id")
  status           String
  amount           Decimal  @db.Decimal(10, 2)
  rawResponse      Json?    @map("raw_response")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  refunds Refund[]

  @@map("payments")
}

enum ComplaintType {
  RECLAMO
  QUEJA
}

// Libro de Reclamaciones Virtual, required for all e-commerce in Peru (D.S. 011-2011-PCM /
// Ley 29571). Anonymous/public submission — a consumer filing a complaint has no account.
// correlativo is the "numeración correlativa" the regulation requires on each sheet, separate
// from the UUID primary key (which is just our internal reference).
model Complaint {
  id               String        @id @default(uuid())
  correlativo      Int           @default(autoincrement())
  type             ComplaintType
  fullName         String        @map("full_name")
  documentType     String        @map("document_type")
  documentNumber   String        @map("document_number")
  address          String
  phone            String?
  email            String
  isMinor          Boolean       @default(false) @map("is_minor")
  guardianName     String?       @map("guardian_name")
  goodType         String        @map("good_type")
  goodDescription  String        @map("good_description")
  claimedAmount    Decimal?      @map("claimed_amount") @db.Decimal(10, 2)
  detail           String
  request          String
  providerResponse String?       @map("provider_response")
  respondedAt      DateTime?     @map("responded_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  @@map("complaints")
}

enum InvoiceType {
  BOLETA
  FACTURA
  NOTA_CREDITO
}

enum InvoiceStatus {
  PENDING_SUNAT // SUNAT no respondió (no es un rechazo) — el XML ya está firmado, se reintenta el mismo envío
  ISSUED
  FAILED
  // El comprobante fue corregido por una nota de crédito de anulación total (motivo 01/06 del
  // catálogo 09) que SUNAT aceptó. Antes era un valor huérfano del enum, sin ningún flujo que lo
  // produjera — ahora lo setea IssueCreditNoteUseCase.
  VOID
}

// Correlative counter per (type, series). The key is composite, not just `type`, because a nota
// de crédito's series depends on WHICH document it corrects — BC01 when it corrects a boleta,
// FC01 when it corrects a factura (see resolveNoteSeries in note-catalogs.ts) — so a single
// NOTA_CREDITO row would force two independent SUNAT sequences to share one counter, which SUNAT
// rejects. Boleta/Factura keep exactly one row each (B001/F001), so their behavior is unchanged.
// Updated atomically via upsert+increment — see PrismaInvoiceRepository.reserveNumber.
model InvoiceCounter {
  type       InvoiceType
  series     String
  lastNumber Int         @default(0) @map("last_number")

  @@id([type, series])
  @@map("invoice_counters")
}

// Comprobante de pago electrónico (SUNAT): boleta, factura o nota de crédito. NOT auto-issued on
// payment: this is a manual ADMIN action on an already-paid order (see IssueInvoiceUseCase).
// Integración directa con SUNAT (sin PSE/OSE) vía SunatInvoicingGateway — ver
// src/infrastructure/invoicing/sunat/.
//
// Las notas de crédito viven en esta misma tabla, no en una propia: comparten TODO el ciclo de
// vida (correlativo reservado antes de emitir, firma XAdES, envío SOAP, PENDING_SUNAT con
// reintento sobre el mismo signedXml, PDF bajo demanda). Una tabla aparte habría duplicado esos
// ocho campos y el worker de reintento. Lo que las distingue son los dos campos de abajo.
model Invoice {
  id               String        @id @default(uuid())
  // No longer @unique: an order holds its comprobante AND the notas de crédito that correct it.
  orderId          String        @map("order_id")
  order            Order         @relation(fields: [orderId], references: [id])
  type             InvoiceType
  status           InvoiceStatus
  series           String
  number           Int
  documentType     String        @map("document_type")
  documentNumber   String        @map("document_number")
  businessName     String?       @map("business_name")
  pdfUrl           String?       @map("pdf_url")
  xmlUrl           String?       @map("xml_url")
  providerResponse Json?         @map("provider_response")
  // XML firmado, persistido tal cual se envió — necesario para reintentar un envío PENDING_SUNAT
  // sin volver a firmar (la firma ya es válida, lo que falló fue la disponibilidad de SUNAT).
  signedXml        String?       @db.Text @map("signed_xml")
  sunatRetryCount  Int           @default(0) @map("sunat_retry_count")
  issuedAt         DateTime?     @map("issued_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  // Solo en NOTA_CREDITO: qué comprobante corrige y por qué (catálogo 09). El par
  // DiscrepancyResponse/BillingReference del XML sale de acá — es lo que hace que SUNAT la lea
  // como una corrección de un documento existente y no como un comprobante suelto.
  relatedInvoiceId String?       @map("related_invoice_id")
  relatedInvoice   Invoice?      @relation("InvoiceCorrections", fields: [relatedInvoiceId], references: [id])
  corrections      Invoice[]     @relation("InvoiceCorrections")
  noteReasonCode   String?       @map("note_reason_code")
  refundId         String?       @unique @map("refund_id")
  refund           Refund?       @relation(fields: [refundId], references: [id])

  @@index([orderId])
  @@index([relatedInvoiceId])
  @@map("invoices")
}
